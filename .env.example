# Server listeners. Use 0.0.0.0 only when the service must be reachable externally.
QGAI_HTTP_HOST=127.0.0.1
QGAI_HTTP_PORT=10925
QGAI_PROCESS_WS_HOST=127.0.0.1
QGAI_PROCESS_WS_PORT=4440
QGAI_UTILS_WS_HOST=127.0.0.1
QGAI_UTILS_WS_PORT=3304

# Optional API integration.
HF_API_TOKEN=

# Optional local models.
QGAI_BASE_MODEL_PATH=
QGAI_LORA_MODEL_PATH=
QGAI_WHISPER_MODEL=medium

# Optional transport encryption. Must contain 16, 24, or 32 UTF-8 bytes.
QGAI_AES_KEY=
